{
  "name": "mama-sauti",
  "version": "0.1.0",
  "private": true,
  "description": "A Community Health Promoter's conversational screening assistant for Kenyan mothers, in natural Kiswahili-English code-switching.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "smoke:sahara": "tsx scripts/smoke-sahara.ts",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "derive:floor": "tsx scripts/derive-deletion-floor.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
