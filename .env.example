# MAMA-SAUTI — copy to .env.local and fill in. .env.local is gitignored.
# §14.5: keys are server-side only and never reach a client bundle.

# ---------------------------------------------------------------------------
# Intron Sahara v2.5 — REQUIRED. The competition's mandatory ASR (§8.2 M3).
# ---------------------------------------------------------------------------
SAHARA_API_KEY=
# Corrections OFF is the shipped configuration and the benchmark's primary column (§17.5).
# Set to "false" ONLY to measure what the undisclosed post-processor contributes.
SAHARA_DISABLE_LLM_CORRECTIONS=true
# "sahara" (default) or "mock". Mock must be set explicitly so a demo can never
# silently run on fixtures.
ASR_PROVIDER=sahara

# ---------------------------------------------------------------------------
# Extraction / probe generation LLM.
# PROVISIONAL: a free tier while the provider is being decided. The spec (§17.1)
# recommends Claude Sonnet. Revisit before submission.
#   xai | gemini | groq | openrouter | cerebras | mistral | openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=xai
XAI_API_KEY=
# Optional override; each provider has a sensible default in lib/llm/index.ts
# LLM_MODEL=grok-4-fast

# Alternatives, uncomment the one you use:
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Database. SQLite today; swap the URL for Neon/Supabase and change the Prisma
# provider to "postgresql" when you provision one. See prisma/schema.prisma.
# ---------------------------------------------------------------------------
# NOTE: DATABASE_URL lives in .env, not here — the Prisma CLI does not read .env.local.
# DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Application access. Set unique values before production deployment.
# Normal users are scoped to the CHP code entered at sign-in; administrators can
# review operational controls and the benchmark comparison workspace.
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=
AUTH_USER_PASSWORD=
AUTH_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Hugging Face — benchmark only (gated datasets AfriSwitchCare / AfriSwitch).
# Not used by the product.
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# Admin view (/admin). A shared passphrase that keeps the technical surface off
# a CHP's phone and gates the demo view. THIS IS NOT AUTHENTICATION — a CHP code
# is an identifier, not a secret (§14.5), and real auth is pilot work (§17.10).
# Leave unset and /admin refuses to open at all.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=
